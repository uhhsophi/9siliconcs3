def get_chinese_zodiac(): #Creates a Function
    zodiac_animals = [ #Creates a list of the Chinese Zodiac Signs
    "Rat (鼠 / Shǔ)",
    "Ox (牛 / Niú)",
    "Tiger (虎 / Hǔ)",
    "Rabbit (兔 / Tù)",
    "Dragon (龙 / Lóng)",
    "Snake (蛇 / Shé)",
    "Horse (马 / Mǎ)",
    "Goat (羊 / Yáng)",
    "Monkey (猴 / Hóu)",
    "Rooster (鸡 / Jī)",
    "Dog (狗 / Gǒu)",
    "Pig (猪 / Zhū)"
    ]
    while True: #Sets a Loop that traps the user to input their birth year
        try:
            birthyear = int(input("Enter your birth year: "))
            
            if birthyear < 1900:
                print("Invalid Year, it should not be earlier than 1900")
                continue
            
            index = (birthyear - 1900) % 12 #Computes the remainder of the computed birth year which then serves as the index for the list of Zodiac Animals
            zodiac = zodiac_animals[index]
            
            print(f"Your Chinese Zodiac Sign is: {zodiac}")
            break
            
        except ValueError: #Creates an alternative function which displays a message when an invalid birth year in inputted
            print("Please enter a valid numeric year.")

get_chinese_zodiac() #Calls the entire function
